{
  "name": "doctor-pep-catalogo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync": "node scripts/sync-site.mjs",
    "typecheck": "tsc --noEmit",
    "check:local": "node scripts/check-local-files.mjs",
    "check:copy": "node scripts/check-product-copy.mjs",
    "check:images": "node scripts/check-product-images.mjs",
    "check:html": "node scripts/check-html-quality.mjs",
    "check": "pnpm sync && pnpm check:local && pnpm check:copy && pnpm check:images && pnpm check:html",
    "smoke": "node scripts/smoke-production.mjs",
    "verify": "pnpm typecheck && pnpm check && pnpm build && pnpm smoke",
    "predev": "node scripts/sync-site.mjs",
    "dev": "vinext dev",
    "prebuild": "node scripts/sync-site.mjs",
    "build": "vinext build",
    "postbuild": "node scripts/check-build-output.mjs",
    "start": "vinext start --port 8788",
    "start:cloudflare": "wrangler dev --config dist/server/wrangler.json"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@cloudflare/workers-types": "5.20260918.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  }
}
